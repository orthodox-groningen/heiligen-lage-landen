{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthodox-ronl.github.io/kalender/schemas/entry.schema.json",
  "title": "Heiligenkalender entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "soort", "datum"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "soort": {
      "type": "string",
      "enum": ["heilige", "feest", "vasten"]
    },
    "namen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primair"],
      "description": "Optioneel als de id in data/namen.yaml staat (die wint bij laden).",
      "properties": {
        "primair": { "type": "string", "minLength": 1 },
        "alternatief": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vastenniveau": {
      "type": "string",
      "enum": ["streng", "wijn_olie", "vis", "lichter", "vrij"],
      "description": "Indicatie van strengheid; 'vrij' onderdrukt wekelijks vasten."
    },
    "onderdrukt_wekelijks_vasten": {
      "type": "boolean",
      "description": "Indien true: woensdag/vrijdag-vasten geldt niet in deze periode."
    },
    "datum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waarde": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "van": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "tot": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "weekdagen": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "ISO-weekdag: 1=maandag … 7=zondag"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stijl": {
          "type": "string",
          "enum": ["gregoriaans", "juliaans"],
          "default": "gregoriaans"
        },
        "gregoriaans": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "juliaans": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["waarde"],
            "properties": {
              "waarde": {
                "type": "string",
                "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              },
              "stijl": {
                "type": "string",
                "enum": ["gregoriaans", "juliaans"]
              },
              "toelichting": { "type": "string" }
            }
          }
        },
        "paascyclus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "anker": {
              "type": "string",
              "const": "pascha",
              "default": "pascha"
            },
            "offset_dagen": { "type": "integer" },
            "van_offset_dagen": { "type": "integer" },
            "tot_offset_dagen": { "type": "integer" }
          },
          "anyOf": [
            { "required": ["offset_dagen"] },
            { "required": ["van_offset_dagen", "tot_offset_dagen"] },
            { "required": ["van_offset_dagen"] }
          ]
        },
        "weekdag_relatief": {
          "type": "object",
          "additionalProperties": false,
          "required": ["anker", "weekdag", "richting"],
          "properties": {
            "anker": {
              "type": "string",
              "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
              "description": "Liturgische feestdatum (MM-DD) waar de weekdag aan hangt"
            },
            "weekdag": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "ISO-weekdag: 1=maandag … 7=zondag"
            },
            "welke": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "1 = dichtstbijzijnde in die richting, 2 = de volgende, enz."
            },
            "richting": {
              "type": "string",
              "enum": ["voor", "na"]
            }
          }
        }
      },
      "anyOf": [
        { "required": ["waarde"] },
        { "required": ["paascyclus"] },
        { "required": ["van", "tot"] },
        { "required": ["weekdagen"] },
        { "required": ["weekdag_relatief"] }
      ]
    },
    "observances": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["feest", "vasten", "heilige"]
      },
      "uniqueItems": true
    },
    "titels": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "locaties": {
      "type": "array",
      "description": "Plaats-ids uit data/plaatsen.yaml.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "rustplaats": {
      "type": "object",
      "additionalProperties": false,
      "description": "Waar het lichaam traditioneel rust. Geen reliekenlijst.",
      "required": ["plaats"],
      "properties": {
        "plaats": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "toelichting": { "type": "string" }
      }
    },
    "periode": { "type": "string" },
    "lage_landen": { "type": "boolean" },
    "cyclus": {
      "type": "string",
      "enum": ["jaar", "paascyclus", "wekelijks"]
    },
    "samenvatting": { "type": "string" },
    "verhaal": { "type": "string" },
    "betekenis_lage_landen": {
      "type": "string",
      "description": "Apart stuk: wat deze heilige voor het christendom of de Orthodoxie in de Lage Landen betekende. Herbruikbaar buiten de heiligenpagina."
    },
    "selectie": {
      "type": "string",
      "enum": ["voldoet", "nader-onderzoek", "kandidaat-schrappen"],
      "description": "Toetsing aan de selectiecriteria (heiligen). Ontbreekt: behandel als nader-onderzoek. Niet op de publieke heiligenpagina."
    },
    "selectie_toelichting": {
      "type": "string",
      "description": "Korte toelichting bij selectie, alleen voor beheerders."
    },
    "id_aliassen": {
      "type": "array",
      "description": "Oude ids na samenvoegen van dubbele entries. Bestandsnaam blijft het canonieke id.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "referenties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "bron_id": { "type": "string", "minLength": 1 },
          "geraadpleegd": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "opmerking": { "type": "string" },
          "isbn": { "type": "string", "minLength": 1 },
          "pagina": { "type": "string", "minLength": 1 },
          "locator": {
            "type": "string",
            "minLength": 1,
            "description": "Alternatief voor url (bijv. archiefsignatuur, app-pad)."
          }
        },
        "anyOf": [
          { "required": ["label"] },
          { "required": ["bron_id"] }
        ],
        "oneOf": [
          { "required": ["url"] },
          { "required": ["isbn"] },
          { "required": ["locator"] }
        ]
      }
    },
    "icoon": {
      "type": "object",
      "additionalProperties": false,
      "description": "Alleen een lokaal bestand onder site/static/. Geen hotlink-URL als afbeelding.",
      "properties": {
        "bestand": {
          "type": "string",
          "pattern": "^(?![Hh][Tt][Tt][Pp][Ss]?:).+",
          "description": "Pad relatief t.o.v. site/static/, bv. iconen/willibrord.jpg"
        },
        "bron": { "type": "string" },
        "licentie": { "type": "string" },
        "rechten": { "type": "string", "enum": ["ok", "onbekend", "nee"] }
      }
    },
    "bronlaag": {
      "type": "string",
      "enum": ["nagekeken", "encyclopedie"],
      "default": "encyclopedie",
      "description": "nagekeken = lexikon/vita of vergelijkbare bron; encyclopedie = Wikipedia/heiligen.net. Zelfde paginastructuur."
    }
  }
}
